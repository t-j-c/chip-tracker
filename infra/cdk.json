{
  "app": "npx ts-node src/index.ts",
  "watch": {
    "include": ["src/**"],
    "exclude": ["node_modules", "lib"]
  },
  "context": {
    "env": "dev",
    "projectName": "chip-tracker",
    "dev": {
      "vpc": {
        "cidr": "10.0.0.0/16"
      },
      "ecs": {
        "desiredCount": 1,
        "cpu": 512,
        "memory": 1024
      },
      "rds": {
        "instanceType": "db.t3.micro"
      }
    },
    "prod": {
      "vpc": {
        "cidr": "10.0.0.0/16"
      },
      "ecs": {
        "desiredCount": 2,
        "cpu": 1024,
        "memory": 2048
      },
      "rds": {
        "instanceType": "db.t3.small"
      }
    }
  }
}
