<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ChipTracker.Infrastructure\ChipTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\ChipTracker.Application\ChipTracker.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Applied only when publishing the Lambda bundles (scripts/publish-lambdas.ps1). -->
  <PropertyGroup Condition="'$(LambdaPublish)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One request per Lambda environment: workstation GC uses less memory and starts faster. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

</Project>
