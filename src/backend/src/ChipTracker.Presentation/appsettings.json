{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DynamoDB": {
    "UseLocal": false,
    "ServiceUrl": "",
    "TableName": "ChipTracker_Rooms",
    "RoomTtlDays": 1
  },
  "RateLimiting": {
    "CreateRoomPerMinute": 10,
    "JoinPerMinute": 30,
    "ReadPerMinute": 120,
    "HubConnectPerMinute": 120,
    "HubInvocationBurst": 20,
    "HubInvocationsPerSecond": 5,
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  }
}
